---
layout: layouts/base.njk
---
<div id="post-detail" class="page active">

    <section class="pg" style="
      background: url('{{image or metadata.image}}')
    center/cover;
    ">
      <div class="container px-4 px-lg-5 pg-content">
        <h1><a href="{{page.url}}" class="to">{{title}}</a></h1>
        <h2 class="lead text-white">{{description}}</h2>
      </div>
    </section>

  <section>
    <div class="container px-4 px-lg-5">
      <div style="max-width: 800px; margin: 0 auto">
        <a href="/blog/" data-page="posts" class="nav-link mb-5 d-inline-block"
          >← Back to Articles</a
        >
<h1>{{ title }}</h1>
<p><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
{%- for tag in tags | filterTagList %}
{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
<br><small>Tags: <a href="{{ tagUrl }}" class="me-2">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</small></p>
	{%- endfor %}
 {% if show_toc %}
        <div class="p-4 border-secondary shadow-sm rounded mb-3">
  <h3>{{metadata.table_of_contents}}</h3>
  {{content |toc | safe}}
</div>
{% endif %}
		<heading-anchors>
          {{ content | safe }}
        </heading-anchors>
		
{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<div class="row mt-5 border-top pt-4">
<div class="col-6">{%- if previousPost %}← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>{% endif %}</div>
<div class="col-6 text-end">{%- if nextPost %}Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}</div>
</div>
{%- endif %}
{%- endif %}

      </div>
    </div>
  </section>
</div>