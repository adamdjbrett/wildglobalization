---
layout: layouts/base.njk
---
 <div id="home" class="page active">
  
    <section class="hero" style="
      background: url('{{hero.image}}')
    center/cover;
    ">
      <div class="container px-4 px-lg-5 hero-content">
        <h1><a href="{{metadata.url}}" class="to">{{hero.title1}}<br>{{hero.title2}}</a></h1>
        <div>{{hero.text | md |safe}}</div>
        <div class="d-flex gap-3">
          <a href="{{hero.button1.url}}" class="btn-nav btn-nav-primary">{{hero.button1.text}}</a>
          <a href="{{hero.button2.url}}" class="btn-nav btn-nav-outline" style="border-color: white; color: white;">{{hero.button2.text}}</a>
        </div>
      </div>
    </section>

    <section>
      <div class="container px-4 px-lg-5" id="author">
        <div class="author-feature">
          <img src="{{author.image}}" alt="{{author.name}}" width="100%" height="100%" class="author-img">
          <div>
            <p class="text-uppercase small fw-600 mb-3" style="letter-spacing: 0.1em; color: var(--wg-gray-600);">Featured Author</p>
            <h2 class="section-title">{{author.name}}</h2>
            <p class="section-desc mb-4">{{author.intro}}</p>
            <p class="mb-4" style="color: var(--wg-gray-600);">{{author.text}}</p>
            <a href="{{author.button.url}}" class="btn-nav btn-nav-primary d-inline-block">{{author.button.text}} →</a>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--wg-gray-50);">
      <div class="container px-4 px-lg-5">
        <div class="text-center mb-3">
          <h2 class="section-title">{{timeline.title}}</h2>
          <p class="section-desc mx-auto">{{timeline.description}}</p>
        </div>
        <div class="timeline">
          {% for t in timeline.list %}
          <div class="timeline-item">
            <div class="timeline-year">{{ t.year }}</div>
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <h4>{{ t.title }}</h4>
              <div>{{ t.text |md|safe }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

<section id="article">
  <div class="container px-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-end mb-2">
      <h2 class="section-title">{{ blog.title }}</h2>
      <a href="{{ blog.button.url }}" class="nav-link">{{ blog.button.text }} →</a>
    </div>
    <div class="posts-grid">
      {% for p in collections.posts.slice(0, 3) %}
        <a href="{{ p.url }}" class="post-card">
          {% if p.data.image %}<img src="{{ p.data.image }}" alt="{{ p.data.title }}" class="img-fluid">{% endif %}
          <div class="post-date">{{ p.date | readableDate }}</div>
          <h3 class="post-title">{{ p.data.title }}</h3>
          <p class="post-excerpt">{{ p.data.description or p.data.excerpt }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

    <section id="faq" style="background: var(--wg-gray-50);">
      <div class="container px-4 px-lg-5">
        <h2 class="section-title mb-5">{{faq.title1}}<br>{{faq.title2}}</h2>
        <div class="container">
          {% for f in faq.list %}
          <div class="faq-item">
            <div class="faq-question">
              <span>{{ f.question }}</span>
              <i class="fa-solid fa-plus"></i>
            </div>
            <div class="faq-answer">
              <p>{{ f.answer }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </div>
