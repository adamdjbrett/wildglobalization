---
layout: layouts/base.njk
---

<div id="post-detail">
  <section style="padding-top: 12rem">
    <div class="container px-4 px-lg-5">
      <div class="author-feature">
        <img
          src="{{image or metadata.image}}"
          alt="{{ title }}"
          class="author-img"
        />
        <div>
          <h1 class="section-title">{{ title }}</h1>
          <p class="section-desc mb-4">{{ description }}</p>
          <div class="mb-3" style="color: var(--wg-gray-600)">
            {{ intro | md | safe }}
          </div>
          <div class="mb-5" style="color: var(--wg-gray-600)">
            {{ info | md | safe }}
          </div>
          <div class="d-flex gap-3">
            <a href="{{ button1.url }}" class="btn-nav btn-nav-primary">{{
              button1.text
            }}</a>
            <a href="{{ button2.url }}" class="btn-nav btn-nav-outline">{{
              button2.text
            }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container px-4 px-lg-5">
      <div style="max-width: 800px; margin: 0 auto">
        <heading-anchors>
          {{ content | safe }}
        </heading-anchors>
      </div>
    </div>
  </section>
</div>
