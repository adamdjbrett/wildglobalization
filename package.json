{
	"name": "wildglobalization",
	"version": "0.0.1",
	"description": "wildglobalization is a blog about globalization, technology, and the future of work.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/wildglobalization/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/wildglobalization/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/adamdjbrett/wildglobalization.git"
	},
	"author": {
		"name": "Adam DJ Brett",
		"email": "info@adamdjbrett.com",
		"url": "https://adamdjbrett.com/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"homepage": "https://github.com/adamdjbrett/wildglobalization#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"luxon": "^3.7.2",
		"purgecss": "^6.0.0",
		"prismjs": "^1.30.0",
		"zod": "^4.3.6",
    	"markdown-it-attrs": "^4.3.1",
		"zod-validation-error": "^5.0.0"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5",
		"citation-js": "^0.7.16",
		"eleventy-plugin-toc": "^1.1.5",
		"globby": "^16.1.0",
        "js-yaml": "^4.1.1",
		"markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
		"markdown-it-anchor": "^9.2.0"
	}
}
