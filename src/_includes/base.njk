<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% if title %}{{ title | safe }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/assets/img/favicon-180.png">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <script>
      (function() {
        var saved = localStorage.getItem("theme");
        var preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body class="{% if isHome %}is-home{% else %}is-page{% endif %}">
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header{% if isHome %} site-header--transparent{% else %} site-header--solid{% endif %}" data-site-header>
      <a class="brand" href="/" aria-label="Wild Globalization home">
        <img src="/assets/img/logo.png" alt="Wild Globalization" width="616" height="373">
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
        <span class="visually-hidden">Toggle navigation</span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Primary navigation" data-site-nav>
        <ul>
          {% for item in navigation %}
            <li class="nav-item{% if item.children %} has-children{% endif %}">
              <a href="{{ item.url }}">{{ item.title }}</a>
              {% if item.children %}
                <button class="submenu-toggle" type="button" aria-expanded="false">
                  <span class="visually-hidden">Open {{ item.title }} menu</span>
                  <span aria-hidden="true">⌄</span>
                </button>
                <ul class="submenu">
                  {% for child in item.children %}
                    <li>
                      <a href="{{ child.url }}"{% if child.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ child.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <span class="theme-toggle__sun" aria-hidden="true">☀</span>
        <span class="theme-toggle__moon" aria-hidden="true">☾</span>
      </button>
    </header>
    <main id="content">
      {% block content %}{{ content | safe }}{% endblock %}
    </main>
    <footer class="site-footer">
      <p>&copy; {{ "" | year }} Wild Globalization</p>
    </footer>
    <script src="/assets/js/site.js"></script>
  </body>
</html>
