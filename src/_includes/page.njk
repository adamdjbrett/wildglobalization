{% extends "base.njk" %}

{% block content %}
{% if isHome %}
  <section class="home-hero" data-hero>
    <div class="home-hero__parallax home-hero__parallax--back" aria-hidden="true"></div>
    <div class="home-hero__parallax home-hero__parallax--front" aria-hidden="true"></div>
    <div class="home-hero__content">
      <p class="eyebrow">The Wild Globalization Project</p>
      <h1>Wild Globalization</h1>
    </div>
  </section>
{% else %}
  <section class="page-hero" data-hero>
    <div class="page-hero__image" aria-hidden="true"></div>
    <div class="page-hero__content">
      <h1>{{ title | safe }}</h1>
    </div>
  </section>
{% endif %}

<article class="content-shell{% if isHome %} content-shell--home{% endif %}">
  {{ content | safe }}
</article>
{% endblock %}
